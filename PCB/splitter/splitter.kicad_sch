	(text "BUS PORTS  (12 V + GND + I2C on every port, all in parallel)"
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "2a121872-aa26-514f-8d5e-c8e428e04eb7")
	)
	(text "Same pin-out as the arm board J1: VBUS = +12 V, D+ = I2C_SDA, D- = I2C_SCL, CC/SBU unused.\nAny plain USB-C to USB-C cable with data lines works (e-marked ones too). Never plug a phone or laptop in here.\n33R per line damps the star and limits ESD current into the other ports; H5VUT2U adds only 0.6 pF per line."
		(exclude_from_sim no)
		(at 25.4 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b8818a8b-214d-5c65-a9f0-bbf26469c28b")
	)
