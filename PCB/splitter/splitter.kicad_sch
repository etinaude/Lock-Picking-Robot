	(text "USB-C PD INPUT  (requests 20 V)"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "51c90c43-ac6c-520a-87d5-f652c1f00ea7")
	)
	(text "CH224A asks the charger for 20 V (R1 = 120k on CFG1). Every USB-C PD\ncharger of 45 W or more offers 20 V, so laptop chargers work.\n~{PG} goes low only after 20 V is negotiated; until then Q1 keeps the\nbuck off, and less than 10 uF sits on VBUS (USB PD sink limit).\nCFG2/CFG3 float: CH224A's I2C (0x22/0x23) stays off the robot bus.\nD+/D- unused: PD needs only CC1/CC2 (QC/BC1.2 can't give 20 V)."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a6da7466-f677-51d8-be69-ce58e94d36bc")
	)
