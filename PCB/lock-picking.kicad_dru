(version 1)
(rule "ESP32-S3 SuperMini sits on sockets, so parts may sit under it"
	(condition "A.Reference == 'U1' || B.Reference == 'U1'")
	(constraint courtyard_clearance (min 0mm))
	(severity ignore))
(rule "Wire solder pads sit on a 2.54 mm grid, closer than their default courtyards"
	(condition "A.Reference == 'TP*' && B.Reference == 'TP*'")
	(constraint courtyard_clearance (min 0mm))
	(severity ignore))
(rule "Copper to board edge and to the shaft hole: 0.3 mm (JLC routed-edge minimum is 0.2-0.3)"
	(constraint edge_clearance (min 0.3mm)))
(rule "USB-C locating pegs sit 0.18 mm from the J1 pad toes (manufacturer land pattern)"
	(condition "A.Reference == 'J1' && B.Reference == 'J1'")
	(constraint hole_clearance (min 0.15mm)))
